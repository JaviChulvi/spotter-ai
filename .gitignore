# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pose model weights (regenerable; see scripts/export_model.md)
/public/models/*.onnx
*.pt

# sample / test videos (large, not source)
*.mov
*.MOV
*.mp4

# local scratch: pose dumps, QA frames, verification scripts (regenerable)
/scratchpad/

# editor / IDE
/.vscode/
/.idea/
*.swp

# python bytecode cache (scripts/dump_pose.py, run via the conda env)
__pycache__/
*.py[cod]

# build tool cache
/.turbo/
